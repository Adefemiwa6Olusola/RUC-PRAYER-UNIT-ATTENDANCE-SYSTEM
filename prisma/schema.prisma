generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  EXCO
  ATTENDANCE_OFFICER
  MEMBER
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum SessionStatus {
  SCHEDULED
  OPEN
  CLOSED
}

enum StudentStatus {
  ACTIVE
  INACTIVE
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  password      String
  fullName      String   @map("full_name")
  role          UserRole @default(MEMBER)
  centreId      String?  @map("centre_id")
  isActive      Boolean  @default(true) @map("is_active")
  lastLoginAt   DateTime? @map("last_login_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  centre              Centre?             @relation(fields: [centreId], references: [id])
  attendanceRecords   AttendanceRecord[]  @relation("RecordedBy")
  startedSessions     AttendanceSession[] @relation("StartedBy")
  endedSessions       AttendanceSession[] @relation("EndedBy")
  createdMeetings     Meeting[]           @relation("CreatedBy")
  passwordResets      PasswordReset[]
  auditLogs           AuditLog[]

  @@map("users")
}

model Student {
  id            String        @id @default(cuid())
  fullName      String        @map("full_name")
  matricNo      String        @unique @map("matric_no")
  matricSuffix  String        @map("matric_suffix")
  faculty       String?
  department    String?
  level         String?
  phone         String?
  email         String?
  gender        String?
  birthday      String?
  hostel        String?
  blockNumber   String?       @map("block_number")
  roomNumber    String?       @map("room_number")
  image         String?
  status        StudentStatus @default(ACTIVE)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  attendanceRecords AttendanceRecord[]

  @@index([matricSuffix])
  @@index([matricNo])
  @@index([fullName])
  @@map("students")
}

model Centre {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users               User[]
  meetings            Meeting[]
  attendanceSessions   AttendanceSession[]

  @@map("centres")
}

model PrayerUnit {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  meetings Meeting[]

  @@map("prayer_units")
}

model Meeting {
  id            String   @id @default(cuid())
  title         String
  description   String?
  meetingDate   DateTime @map("meeting_date")
  startTime     String?  @map("start_time")
  endTime       String?  @map("end_time")
  centreId      String   @map("centre_id")
  prayerUnitId  String?  @map("prayer_unit_id")
  isRecurring   Boolean  @default(false) @map("is_recurring")
  createdById   String   @map("created_by_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  centre            Centre              @relation(fields: [centreId], references: [id])
  prayerUnit        PrayerUnit?         @relation(fields: [prayerUnitId], references: [id])
  createdBy         User                @relation("CreatedBy", fields: [createdById], references: [id])
  attendanceSessions AttendanceSession[]

  @@index([meetingDate])
  @@index([centreId])
  @@map("meetings")
}

model AttendanceSession {
  id          String        @id @default(cuid())
  meetingId   String        @map("meeting_id")
  centreId    String        @map("centre_id")
  status      SessionStatus @default(SCHEDULED)
  startedAt   DateTime?     @map("started_at")
  endedAt     DateTime?     @map("ended_at")
  startedById String?       @map("started_by_id")
  endedById   String?       @map("ended_by_id")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  meeting           Meeting             @relation(fields: [meetingId], references: [id])
  centre            Centre              @relation(fields: [centreId], references: [id])
  startedBy         User?               @relation("StartedBy", fields: [startedById], references: [id])
  endedBy           User?               @relation("EndedBy", fields: [endedById], references: [id])
  attendanceRecords AttendanceRecord[]

  @@index([meetingId])
  @@index([centreId])
  @@map("attendance_sessions")
}

model AttendanceRecord {
  id            String           @id @default(cuid())
  studentId     String           @map("student_id")
  sessionId     String           @map("session_id")
  status        AttendanceStatus @default(PRESENT)
  checkInAt     DateTime         @default(now()) @map("check_in_at")
  recordedById  String?          @map("recorded_by_id")
  createdAt     DateTime         @default(now()) @map("created_at")

  student    Student            @relation(fields: [studentId], references: [id])
  session    AttendanceSession  @relation(fields: [sessionId], references: [id])
  recordedBy User?              @relation("RecordedBy", fields: [recordedById], references: [id])

  @@unique([studentId, sessionId])
  @@index([studentId])
  @@index([sessionId])
  @@index([createdAt])
  @@map("attendance_records")
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([token])
  @@map("password_resets")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  metadata  Json?
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([action])
  @@index([entity])
  @@index([createdAt])
  @@map("audit_logs")
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}
